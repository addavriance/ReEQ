{
  "name": "reeq-audio-eq",
  "version": "2.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "zip": "npm run build && bestzip extension.zip dist/*",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "author": "Addavriance",
  "license": "MIT",
  "description": "ReEQ - Modern audio equalizer and bass boost extension",
  "homepage": "https://github.com/addavriance/BassBoostExtension",
  "repository": {
    "type": "git",
    "url": "https://github.com/addavriance/BassBoostExtension.git"
  },
  "keywords": [
    "chrome-extension",
    "audio-equalizer",
    "bass-boost",
    "audio-processing",
    "webaudio"
  ],
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.31",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "bestzip": "^2.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
