{
  "manifest_version": 3,
  "name": "ReEQ: Audio EQ & Bass Boost",
  "short_name": "ReEQ",
  "description": "EQ any audio on the web. Boost bass, adjust highs, customize sound. Modern revival of the classic audio extension.",
  "version": "2.1.3",
  "version_name": "2.1.3",
  "author": "Addavriance",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/action-icon16.png",
      "32": "icons/action-icon32.png",
      "48": "icons/action-icon48.png",
      "128": "icons/action-icon128.png"
    },
    "default_title": "ReEQ Audio Controls",
    "default_popup": "src/popup/index.html"
  },

  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "scripting",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "web_accessible_resources": [{
    "resources": ["assets/*"],
    "matches": ["<all_urls>"]
  }]
}
